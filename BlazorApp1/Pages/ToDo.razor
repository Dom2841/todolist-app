@page "/todo"

<h3>รายการงานที่ต้องทำ (To-Do List)</h3>

<div class="input-group mb-3">
    <input class="form-control" placeholder="พิมพ์รายการงานที่นี่..." @bind="newItemTitle" />
    <button class="btn btn-primary" @onclick="AddItem">เพิ่มรายการ</button>
</div>

<ul class="list-group">
    @foreach (var item in todoItems)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <input type="checkbox" class="form-check-input me-2" @bind="item.IsDone" />
                <span style="@(item.IsDone ? "text-decoration: line-through;" : "")">@item.Title</span>
            </div>
            <button class="btn btn-danger btn-sm" @onclick="() => DeleteItem(item)">ลบ</button>
        </li>
    }
</ul>

@code {
    private List<TodoItem> todoItems = new();
    private string newItemTitle = "";

    private void AddItem()
    {
        if (!string.IsNullOrWhiteSpace(newItemTitle))
        {
            todoItems.Add(new TodoItem { Title = newItemTitle, IsDone = false });
            newItemTitle = "";
        }
    }

    private void DeleteItem(TodoItem item)
    {
        todoItems.Remove(item);
    }

    public class TodoItem
    {
        public string Title { get; set; } = "";
        public bool IsDone { get; set; }
    }
}