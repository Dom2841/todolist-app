@page "/todo"

<PageTitle>To Do</PageTitle>

<h1>To Do</h1>

<div class="todo-container">
    <div class="input-group mb-3">
        <input class="form-control"
               placeholder="Add a new task"
               @bind="newTodo"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown" />
        <button class="btn btn-primary"
                @onclick="AddTodo"
                disabled="@string.IsNullOrWhiteSpace(newTodo)">
            Add
        </button>
    </div>

    @if (!todos.Any())
    {
        <p class="text-muted">No tasks yet.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var item in todos)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               checked="@item.IsDone"
                               @onchange="() => ToggleTodo(item.Id)" />
                        <label class="form-check-label @(item.IsDone ? "text-decoration-line-through" : "")">
                            @item.Text
                        </label>
                    </div>

                    <button class="btn btn-sm btn-outline-danger"
                            @onclick="() => RemoveTodo(item.Id)">
                        Delete
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    private string newTodo = string.Empty;
    private List<TodoItem> todos = new()
    {
        new() { Id = 1, Text = "Plan the day", IsDone = false },
        new() { Id = 2, Text = "Review project", IsDone = true }
    };

    private void AddTodo()
    {
        if (string.IsNullOrWhiteSpace(newTodo))
        {
            return;
        }

        todos.Add(new TodoItem
        {
            Id = todos.Count == 0 ? 1 : todos.Max(t => t.Id) + 1,
            Text = newTodo.Trim(),
            IsDone = false
        });

        newTodo = string.Empty;
    }

    private void ToggleTodo(int id)
    {
        var item = todos.FirstOrDefault(x => x.Id == id);
        if (item is null)
        {
            return;
        }

        item.IsDone = !item.IsDone;
    }

    private void RemoveTodo(int id)
    {
        var item = todos.FirstOrDefault(x => x.Id == id);
        if (item is not null)
        {
            todos.Remove(item);
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTodo();
        }
    }

    private class TodoItem
    {
        public int Id { get; set; }
        public string Text { get; set; } = string.Empty;
        public bool IsDone { get; set; }
    }
}
